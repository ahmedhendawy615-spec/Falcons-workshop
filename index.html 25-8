<script>
let visits = [];
let currentType = 'doctor';
let geoCoords = null;
let session = null; // { role: 'member'|'moderator', name: string, team: string }
const DEFAULT_TEAM_NAMES = ['Team 1', 'Team 2', 'Team 3', 'Team 4', 'Team 5'];

const FIREBASE_URL = 'https://falcons-workshop-default-rtdb.firebaseio.com';
const FIREBASE_API_KEY = 'AIzaSyAPbrc8SxGVUs8l4tuIAyn9SBQhEVJjS64';

let authToken = null;
let currentUid = null;

/* Real Firebase email/password sign-in. Replaces the old anonymous
   sign-in — every session now carries a stable, real uid that
   Firebase Rules can check (root.child('moderators').child(auth.uid)).
   Accounts themselves are created manually in the Firebase Console
   (Authentication > Users) — this app never creates accounts. */
async function signInWithPassword(email, password){
  try{
    const res = await fetch(`https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=${FIREBASE_API_KEY}`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ email, password, returnSecureToken: true })
    });
    const data = await res.json();
    if(!res.ok) return { ok:false, error: data.error && data.error.message };
    authToken = data.idToken;
    currentUid = data.localId;
    return { ok:true, uid: data.localId, idToken: data.idToken, refreshToken: data.refreshToken };
  }catch(e){
    console.error('Sign-in failed', e);
    return { ok:false, error: 'network' };
  }
}

/* Exchanges a stored refreshToken for a new idToken without needing
   the password again. Only works online — used both to keep a long
   member session alive and to re-authenticate right before syncing
   visits that were queued while offline. */
async function refreshIdToken(refreshToken){
  try{
    const res = await fetch(`https://securetoken.googleapis.com/v1/token?key=${FIREBASE_API_KEY}`, {
      method: 'POST',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: `grant_type=refresh_token&refresh_token=${encodeURIComponent(refreshToken)}`
    });
    const data = await res.json();
    if(!res.ok) return null;
    return { idToken: data.id_token, refreshToken: data.refresh_token, uid: data.user_id };
  }catch(e){
    console.error('Token refresh failed', e);
    return null;
  }
}

function signOutLocal(){
  authToken = null;
  currentUid = null;
}

/* Creates a brand-new Firebase Auth account (used when the moderator
   adds a member from the app). Deliberately does NOT touch the
   global authToken/currentUid — those must keep belonging to the
   moderator who is signed in and doing the adding. */
async function signUpWithPassword(email, password){
  try{
    const res = await fetch(`https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=${FIREBASE_API_KEY}`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ email, password, returnSecureToken: true })
    });
    const data = await res.json();
    if(!res.ok) return { ok:false, error: data.error && data.error.message };
    return { ok:true, uid: data.localId };
  }catch(e){
    console.error('Sign-up failed', e);
    return { ok:false, error: 'network' };
  }
}

function withAuth(url){
  return authToken ? `${url}${url.includes('?') ? '&' : '?'}auth=${authToken}` : url;
}

/* Before login there is no token yet — that's fine for paths marked
   public (".read": true) in the Rules, like team names. Anything
   sensitive requires authToken to be set by a successful sign-in. */
async function dbGet(path){
  try{
    const res = await fetch(withAuth(`${FIREBASE_URL}/${path}.json`));
    if(!res.ok) throw new Error('Request failed');
    return await res.json();
  }catch(e){
    console.error('dbGet failed', e);
    return null;
  }
}

async function dbSet(path, value){
  try{
    const res = await fetch(withAuth(`${FIREBASE_URL}/${path}.json`), {
      method: 'PUT',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(value)
    });
    if(!res.ok) throw new Error('Request failed');
    return true;
  }catch(e){
    console.error('dbSet failed', e);
    return false;
  }
}

async function dbDelete(path){
  try{
    const res = await fetch(withAuth(`${FIREBASE_URL}/${path}.json`), { method: 'DELETE' });
    if(!res.ok) throw new Error('Request failed');
    return true;
  }catch(e){
    console.error('dbDelete failed', e);
    return false;
  }
}

/* name -> convention email used for member accounts, e.g.
   "Ahmed Mostafa" -> "ahmed-mostafa@falcons.local".
   The moderator must create the Firebase Auth account with this
   exact email when adding a member. */
function slugify(name){
  return name.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}
function nameToEmail(name){
  return `${slugify(name)}@falcons.local`;
}

/* ---------- Offline support: local session + pending-visit queue ----------
   Two separate things are cached in localStorage (device-only, never
   synced anywhere itself):
   1. The member's last signed-in session + refresh token, so the app
      can log them back in automatically even with zero connectivity
      (real Firebase sign-in requires a network call, which a fully
      offline page load can't make).
   2. Any visits saved while offline, queued here until a connection
      is available, then flushed to Firebase automatically. */
const MEMBER_SESSION_KEY = 'falcons-member-session';
const PENDING_VISITS_KEY = 'falcons-pending-visits';

function saveMemberSessionLocally(sessionData, idToken, refreshToken){
  try{
    localStorage.setItem(MEMBER_SESSION_KEY, JSON.stringify({ session: sessionData, idToken, refreshToken }));
  }catch(e){ console.error('Could not persist session locally', e); }
}

function loadMemberSessionLocally(){
  try{
    const raw = localStorage.getItem(MEMBER_SESSION_KEY);
    return raw ? JSON.parse(raw) : null;
  }catch(e){ return null; }
}

function clearMemberSessionLocally(){
  try{ localStorage.removeItem(MEMBER_SESSION_KEY); }catch(e){}
}

function getPendingVisits(){
  try{
    const raw = localStorage.getItem(PENDING_VISITS_KEY);
    return raw ? JSON.parse(raw) : [];
  }catch(e){ return []; }
}

function savePendingVisits(list){
  try{ localStorage.setItem(PENDING_VISITS_KEY, JSON.stringify(list)); }
  catch(e){ console.error('Could not persist pending visits locally', e); }
}

function queueVisitOffline(visit){
  const pending = getPendingVisits();
  pending.push(visit);
  savePendingVisits(pending);
  updatePendingBadge();
}

function updatePendingBadge(){
  const el = $('pendingSyncBadge');
  if(!el) return;
  const count = getPendingVisits().length;
  if(count === 0){
    el.classList.add('hidden');
  }else{
    el.classList.remove('hidden');
    $('pendingSyncText').textContent = `⏳ ${count} visit${count===1?'':'s'} waiting to sync`;
  }
}

let syncInFlight = false;

/* Called on reconnect, on page load if already online, and after
   every manual "Sync Now" tap. Refreshes the token first (idTokens
   expire after ~1 hour, and a lot could've happened while offline),
   then replays each queued visit through the normal save path. */
async function flushPendingVisits(){
  if(syncInFlight) return;
  const pending = getPendingVisits();
  if(pending.length === 0 || !navigator.onLine) return;

  syncInFlight = true;
  const saved = loadMemberSessionLocally();
  if(saved && saved.refreshToken){
    const refreshed = await refreshIdToken(saved.refreshToken);
    if(refreshed){
      authToken = refreshed.idToken;
      currentUid = refreshed.uid;
      saveMemberSessionLocally(saved.session, refreshed.idToken, refreshed.refreshToken);
    }
  }

  const stillPending = [];
  for(const visit of pending){
    const ok = await saveOneVisit(visit);
    if(ok){
      bumpVisitSummary(visit.member, 1);
    }else{
      stillPending.push(visit);
    }
  }
  savePendingVisits(stillPending);
  updatePendingBadge();
  syncInFlight = false;

  if(stillPending.length === 0 && pending.length > 0){
    showToast('All pending visits synced.');
    if(session && session.role === 'member') loadVisits();
  }
}

window.addEventListener('online', flushPendingVisits);

$('syncNowBtn').onclick = () => {
  if(!navigator.onLine){
    showToast('Still no connection — will retry automatically once you\'re back online.');
    return;
  }
  flushPendingVisits();
};
if('serviceWorker' in navigator){
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./sw.js').catch(e => console.error('Service worker registration failed', e));
  });
}

/* Runs once on page load, before anything else. If this device has a
   member session saved from a previous successful (online) login, log
   them straight back in from the cached data — no network call
   required — so the app is usable even opening it with zero signal.
   If we do have a connection, refresh the token in the background so
   writes work immediately rather than waiting for the first failure. */
async function tryRestoreMemberSession(){
  const saved = loadMemberSessionLocally();
  if(!saved || !saved.session) return false;

  authToken = saved.idToken;
  currentUid = saved.session.uid;
  session = saved.session;

  if(navigator.onLine && saved.refreshToken){
    const refreshed = await refreshIdToken(saved.refreshToken);
    if(refreshed){
      authToken = refreshed.idToken;
      currentUid = refreshed.uid;
      saveMemberSessionLocally(session, refreshed.idToken, refreshed.refreshToken);
    }
  }

  enterApp();
  updatePendingBadge();
  if(navigator.onLine) flushPendingVisits();
  return true;
}

/* Public visit-count summary (falcons-visit-summary/{slug} = {name, total}).
   Kept separate from falcons-visit-log so the public Dashboard tab can
   read counts only, without exposing full visit details (contacts,
   notes, locations) to unauthenticated visitors. Rules: ".read": true,
   ".write": "auth != null" on this path. */
async function bumpVisitSummary(memberName, delta){
  const slug = slugify(memberName);
  if(!slug) return;
  const current = await dbGet(`falcons-visit-summary/${slug}`);
  const total = Math.max(0, ((current && current.total) || 0) + delta);
  await dbSet(`falcons-visit-summary/${slug}`, { name: memberName, total });
}

const $ = id => document.getElementById(id);

/* ---------- Collapsible panel headers (moderator panels) ---------- */
document.addEventListener('click', (e) => {
