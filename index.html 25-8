          </div>
        `).join('');
    return `
      <h2 class="history-subhead">${escapeHtml(teamName)}</h2>
      ${memberRows}
    `;
  }).join('');
  $('teamRosters').innerHTML = rosterHtml;

  // Teams Overview: team name + total visits
  const overviewRows = teamNames.map(teamName => {
    const total = visits.filter(v => v.team === teamName).length;
