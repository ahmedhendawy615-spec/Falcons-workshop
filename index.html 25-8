    return;
  }
  container.innerHTML = rows.map(([name, count]) => `
    <div class="member-row" data-name="${escapeHtml(name)}">
      <div class="mname">${escapeHtml(name)}</div>
      <div class="mcount">${count} visit${count===1?'':'s'}</div>
    </div>
  `).join('');

  container.querySelectorAll('.member-row').forEach(row => {
    row.onclick = () => openMemberDetail(row.dataset.name);
  });
}

function renderVisitCard(v, indexLabel){
  const customHtml = v.customAnswers && Object.keys(v.customAnswers).length > 0
    ? Object.values(v.customAnswers).map(a => `<div>${escapeHtml(a.label)}: <b>${escapeHtml(a.value)}</b></div>`).join('')
    : '';
  return `
    <div class="modal-visit">
      <div class="mv-top">
        <span class="mv-contact">${indexLabel ? indexLabel + ' ' : ''}${escapeHtml(v.contact)}</span>
        <span class="mv-date">${v.date || ''}</span>
      </div>
      <div class="mv-meta">
        <span class="tag ${v.type}" style="margin-right:6px;">${v.type}</span>
        Visited by ${escapeHtml(v.member)} · ${v.team ? escapeHtml(v.team) + ' · ' : ''}${v.specialty ? escapeHtml(v.specialty) + ' · ' : ''}
        ${v.order === 'yes' ? 'Order: Yes · ' : ''}${v.healthDay === 'yes' ? 'Health Day · ' : ''}
        📍 ${v.coords ? `<a href="${mapLink(v)}" target="_blank" rel="noopener">${locLabel(v)}</a>` : locLabel(v)}
      </div>
      ${customHtml ? `<div class="mv-meta">${customHtml}</div>` : ''}
      ${v.notes ? `<div class="mv-notes">"${escapeHtml(v.notes)}"</div>` : ''}
    </div>
  `;
}

function openMemberDetail(name){
  const memberVisits = visits
    .filter(v => v.member === name)
    .slice()
    .sort((a,b) => (a.loggedAt || '').localeCompare(b.loggedAt || ''));

  $('modalMemberName').textContent = `${name} — ${memberVisits.length} visit${memberVisits.length===1?'':'s'}`;

  const body = $('modalVisitList');
  if(memberVisits.length === 0){
    body.innerHTML = '<div class="history-empty">No visits yet.</div>';
  }else{
    body.innerHTML = memberVisits.map((v,i) => renderVisitCard(v, `#${i+1}`)).join('');
  }

  $('memberDetailModal').classList.remove('hidden');
}

function openVisitDetail(id){
  const v = visits.find(x => x.id === id);
  if(!v) return;
  $('modalMemberName').textContent = 'Visit Details';
  $('modalVisitList').innerHTML = renderVisitCard(v, '');
  $('memberDetailModal').classList.remove('hidden');
}

$('modalCloseBtn').onclick = () => {
  $('memberDetailModal').classList.add('hidden');
};
$('memberDetailModal').onclick = (e) => {
  if(e.target.id === 'memberDetailModal') $('memberDetailModal').classList.add('hidden');
};

/* ---------- Orders Dashboard (moderator only) ---------- */
function renderOrdersDashboard(){
  if(!session || session.role !== 'moderator') return;

  const counts = {};
  visits.forEach(v => {
    if(!counts[v.member]) counts[v.member] = {orders: 0, total: 0};
    counts[v.member].total += 1;
    if(v.order === 'yes') counts[v.member].orders += 1;
  });

  const rows = Object.entries(counts)
    .map(([name, c]) => ({name, ...c}))
    .filter(r => r.orders > 0)
    .sort((a,b) => b.orders - a.orders);

  const container = $('ordersDashTable');
  if(rows.length === 0){
    container.innerHTML = '<div class="history-empty">No orders logged yet.</div>';
    return;
  }
  const maxOrders = Math.max(1, ...rows.map(r => r.orders));
  container.innerHTML = rows.map(r => `
    <div class="dash-row">
      <div class="dash-name">${escapeHtml(r.name)}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${(r.orders/maxOrders*100).toFixed(0)}%"></div></div>
      <div class="dash-num">${r.orders}</div>
      <div class="dash-num" style="color:var(--muted);font-size:10px;">of ${r.total}</div>
      <div></div>
    </div>
  `).join('');
}

/* ---------- Custom Question Insights (moderator only) ---------- */
async function renderCustomQuestionInsights(){
  if(!session || session.role !== 'moderator') return;

  const fields = await getCustomFields();
  const container = $('customInsightsArea');

  if(fields.length === 0){
    container.innerHTML = '<div class="history-empty">No custom questions yet.</div>';
    return;
  }

  const teamNames = await getTeamNames();

  container.innerHTML = fields.map(field => {
    const teamsHtml = teamNames.map(teamName => {
      const answers = visits
        .filter(v => v.team === teamName && v.customAnswers && v.customAnswers[field.id])
        .map(v => v.customAnswers[field.id].value);

      if(answers.length === 0){
        return `<div class="team-subhead">${escapeHtml(teamName)}</div><div class="history-empty" style="padding:10px;">No answers yet.</div>`;
      }

      if(field.type === 'choice'){
        const counts = {};
        field.options.forEach(o => counts[o] = 0);
        answers.forEach(a => { counts[a] = (counts[a] || 0) + 1; });
        const total = answers.length;
        const rows = Object.entries(counts).map(([opt, count]) => {
          const pct = total > 0 ? Math.round((count / total) * 100) : 0;
          return `
            <div class="dash-row">
              <div class="dash-name">${escapeHtml(opt)}</div>
              <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
              <div class="dash-num">${pct}%</div>
              <div class="dash-num" style="color:var(--muted);font-size:10px;">${count}/${total}</div>
              <div></div>
            </div>
          `;
        }).join('');
        return `<div class="team-subhead">${escapeHtml(teamName)}</div>${rows}`;
      }else{
        const list = answers.map(a => `<div class="free-answer">"${escapeHtml(a)}"</div>`).join('');
        return `<div class="team-subhead">${escapeHtml(teamName)}</div>${list}`;
      }
    }).join('');

    return `
      <div class="question-block">
        <div class="q-title">${escapeHtml(field.label)}${field.type === 'choice' ? '' : ' (free text)'}</div>
        ${teamsHtml}
      </div>
    `;
  }).join('');
}

function renderAll(){
  populateMemberFilter();
  renderList();
  renderDashboard();
  renderTeamDashboards();
  renderAllMembersList();
  renderOrdersDashboard();
  renderCustomQuestionInsights();
}

$('filterMember').onchange = renderList;
$('filterType').onchange = renderList;
$('searchBox').oninput = renderList;

/* ---------- Falcons History (photo gallery) ---------- */
const HISTORY_CATEGORIES = ['exmods', 'winners'];

async function getHistoryPhotos(){
  const result = await dbGet('falcons-history');
  if(!result || typeof result !== 'object') return [];
  // Use the real database key as the id, so photos saved under the
  // old array-based format (before per-photo keys) can still be
  // edited/deleted correctly even if their stored "id" field doesn't
  // match their actual location.
  return Object.entries(result).map(([key, val]) => ({ ...val, id: key }));
}

async function saveOnePhoto(photo){
  const ok = await dbSet(`falcons-history/${photo.id}`, photo);
  if(!ok) showToast('Could not save — the photo may be too large.');
  return ok;
}

async function deleteOnePhoto(id){
  const ok = await dbDelete(`falcons-history/${id}`);
  if(!ok) showToast('Delete failed — check connection.');
  return ok;
}

async function loadHistoryGallery(){
  const photos = await getHistoryPhotos();
  const editable = session && session.role === 'moderator';
  HISTORY_CATEGORIES.forEach(cat => {
    const catPhotos = photos.filter(p => p.category === cat);
    if($('historyGalleryLogin-' + cat)){
      renderHistoryGallery('historyGalleryLogin-' + cat, catPhotos, false);
    }
    if(editable && $('historyGalleryManage-' + cat)){
      renderHistoryGallery('historyGalleryManage-' + cat, catPhotos, true);
    }
  });
}

function renderHistoryGallery(targetId, photos, editable){
  const el = $(targetId);
  if(!photos || photos.length === 0){
    el.innerHTML = '<div class="history-empty">No photos yet.</div>';
    return;
  }
  el.innerHTML = photos.slice().reverse().map(p => `
    <div class="history-item" data-id="${p.id}">
      <img src="${p.dataUrl}" alt="${escapeHtml(p.caption || 'Falcons Workshop photo')}">
      ${p.caption ? `<div class="cap">${escapeHtml(p.caption)}</div>` : ''}
      ${editable ? `<button class="del-photo" data-id="${p.id}">Remove</button>` : ''}
    </div>
  `).join('');

  if(editable){
    el.querySelectorAll('.del-photo').forEach(btn => {
      btn.onclick = async () => {
        if(!confirm('Remove this photo? This cannot be undone.')) return;
        const ok = await deleteOnePhoto(btn.dataset.id);
        if(ok){
          showToast('Photo removed.');
          loadHistoryGallery();
        }
      };
    });
  }
}

/* ---------- Compress an image file down to a target size before upload ---------- */
function compressImageToDataUrl(file, targetBytes){
  return new Promise((resolve, reject) => {
    const img = new Image();
    const objectUrl = URL.createObjectURL(file);

    img.onload = () => {
      URL.revokeObjectURL(objectUrl);

      let width = img.naturalWidth;
      let height = img.naturalHeight;
      const maxDim = 1600;
      if(width > maxDim || height > maxDim){
        const scale = maxDim / Math.max(width, height);
        width = Math.round(width * scale);
        height = Math.round(height * scale);
      }

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, width, height);

      // Step down quality (and, if needed, dimensions) until the
      // resulting base64 string fits under targetBytes.
      let quality = 0.85;
      const attempt = () => {
        const dataUrl = canvas.toDataURL('image/jpeg', quality);
        if(dataUrl.length <= targetBytes || (quality <= 0.4 && width <= 640)){
          resolve(dataUrl);
          return;
        }
        if(quality > 0.4){
          quality -= 0.1;
        }else{
          width = Math.round(width * 0.8);
          height = Math.round(height * 0.8);
          canvas.width = width;
          canvas.height = height;
          ctx.drawImage(img, 0, 0, width, height);
          quality = 0.7;
        }
        setTimeout(attempt, 0);
      };
      attempt();
    };

    img.onerror = () => {
      URL.revokeObjectURL(objectUrl);
      reject(new Error('Could not read image'));
    };

    img.src = objectUrl;
  });
}

$('historyUploadBtn').onclick = async () => {
  const fileInput = $('historyFileInput');
  const caption = $('historyCaption').value.trim();
  const category = $('historyCategory').value;
  const file = fileInput.files[0];
  if(!file){ showToast('Choose a photo first.'); return; }
  if(!file.type.startsWith('image/')){
    showToast('Please choose an image file.');
    return;
  }

  showToast('Compressing photo…');
  let dataUrl;
  try{
    dataUrl = await compressImageToDataUrl(file, 0.5 * 1024 * 1024);
  }catch(e){
    showToast('Could not process that photo — try a different file.');
    return;
  }

  const photo = {
    id: Date.now().toString(36) + Math.random().toString(36).slice(2,6),
    dataUrl,
    caption,
    category,
    addedBy: session.name,
    date: new Date().toISOString().slice(0,10)
  };
  const ok = await saveOnePhoto(photo);
  if(ok){
    fileInput.value = '';
    $('historyCaption').value = '';
    showToast('Photo added to Falcons History.');
    loadHistoryGallery();
  }
};
