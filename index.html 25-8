async function loadPublicLeaderboard(){
  const el = $('publicLeaderboard');
  el.innerHTML = '<div class="history-empty">Loading...</div>';
  const result = await dbGet('falcons-visit-summary');
  const summary = result && typeof result === 'object' ? Object.values(result) : [];
  const rows = summary
    .map(r => ({name: r.name, total: r.total || 0}))
    .sort((a,b) => b.total - a.total)
    .slice(0, 5);

  if(rows.length === 0){
    el.innerHTML = '<div class="history-empty">No visits logged yet.</div>';
    return;
  }
  const maxTotal = Math.max(1, ...rows.map(r => r.total));
  el.innerHTML = rows.map((r,i) => `
    <div class="dash-row">
      <div class="dash-name">#${i+1} ${escapeHtml(r.name)}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${(r.total/maxTotal*100).toFixed(0)}%"></div></div>
      <div class="dash-num">${r.total}</div>
      <div></div><div></div>
    </div>
  `).join('');
}

