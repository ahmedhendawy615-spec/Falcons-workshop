    return leaderVisitSortDesc ? -cmp : cmp;
  });

  if(teamVisits.length === 0){
    container.innerHTML = '<div class="history-empty">No visits logged for this team yet.</div>';
    return;
  }

  container.innerHTML = teamVisits.map(v => renderVisitCard(v, '')).join('');
}

async function renderLeaderCustomInsights(teamVisits){
  const fields = await getCustomFields();
  const container = $('leaderCustomInsights');

  if(fields.length === 0){
    container.innerHTML = '<div class="history-empty">No custom questions yet.</div>';
    return;
  }

  container.innerHTML = fields.map(field => {
    const answers = teamVisits
      .filter(v => v.customAnswers && v.customAnswers[field.id])
      .map(v => v.customAnswers[field.id].value);

    if(answers.length === 0){
      return `<div class="question-block"><div class="q-title">${escapeHtml(field.label)}</div><div class="history-empty">No answers yet.</div></div>`;
    }

    if(field.type === 'choice'){
      const counts = {};
      field.options.forEach(o => counts[o] = 0);
      answers.forEach(a => { counts[a] = (counts[a] || 0) + 1; });
      const total = answers.length;
      const rows = Object.entries(counts).map(([opt, count]) => {
        const pct = total > 0 ? Math.round((count / total) * 100) : 0;
        return `
          <div class="dash-row">
            <div class="dash-name">${escapeHtml(opt)}</div>
