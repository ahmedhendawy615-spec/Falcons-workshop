<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Falcons Workshop</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy-900:#001D39;
    --navy-700:#0A4174;
    --steel-600:#49769F;
    --teal-500:#4E8EA2;
    --teal-400:#6EA2B3;
    --sky-300:#7BBDE8;
    --sky-100:#BDD8E9;

    --ink:#BDD8E9;
    --paper:#001D39;
    --card:#0A2C4E;
    --accent:#7BBDE8;
    --accent-dim:#173F60;
    --gold:#6EA2B3;
    --muted:#7BA7C4;
    --line:#1D4468;
    --danger:#FF6B5E;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:linear-gradient(160deg, var(--navy-900) 0%, #012347 55%, var(--navy-700) 100%);
    background-attachment:fixed;
    color:var(--ink);
    font-family:'Inter', Arial, sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:880px;margin:0 auto;padding:28px 20px 80px;}
  header{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    border-bottom:2px solid var(--line);
    padding-bottom:16px;
    margin-bottom:24px;
    gap:12px;
    flex-wrap:wrap;
  }
  .brand-mark{display:flex;align-items:center;gap:12px;}
  .falcon-badge{
    width:44px;height:44px;border-radius:50%;
    background:#FFFFFF;
    border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
    overflow:hidden;
    box-shadow:0 0 0 3px rgba(123,189,232,0.15);
  }
  .falcon-badge img{width:100%;height:100%;object-fit:contain;padding:4px;}
  h1{
    font-family:'Space Grotesk', Arial, sans-serif;
    font-weight:700;
    font-size:28px;
    text-transform:uppercase;
    letter-spacing:0.02em;
    letter-spacing:-0.01em;
    margin:0;
    line-height:1.05;
  }
  .eyebrow{
    font-size:11px;text-transform:uppercase;letter-spacing:0.14em;
    color:var(--muted);margin:0 0 2px;
  }
  .stat{text-align:right;font-family:'Courier New', monospace;}
  .stat .num{font-size:26px;font-weight:700;color:var(--accent);}
  .stat .label{font-size:10px;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);}

  .session-bar{
    display:flex;align-items:center;justify-content:space-between;
    background:var(--card);border:1px solid var(--line);border-radius:2px;
    padding:10px 16px;margin-bottom:20px;font-size:12px;
  }
  .role-chip{
    font-size:10px;text-transform:uppercase;letter-spacing:0.08em;font-weight:700;
    padding:3px 8px;border-radius:2px;margin-left:8px;
  }
  .role-chip.moderator{background:var(--gold);color:var(--navy-900);}
  .role-chip.member{background:var(--accent-dim);color:var(--accent);}
  .logout-btn{
    background:none;border:1px solid var(--line);border-radius:2px;
    padding:6px 12px;font-size:11px;cursor:pointer;color:var(--muted);
  }
  .logout-btn:hover{border-color:var(--danger);color:var(--danger);}

  .pending-sync-bar{
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    background:rgba(255,193,7,0.12);border:1px solid #d4a017;border-radius:2px;
    padding:9px 16px;margin-bottom:20px;font-size:12px;color:#e0b23a;
  }
  .sync-now-btn{
    background:none;border:1px solid #d4a017;border-radius:2px;color:#e0b23a;
    padding:5px 12px;font-size:11px;cursor:pointer;white-space:nowrap;
  }
  .sync-now-btn:hover{background:#d4a017;color:var(--navy-900);}

  .panel{
    background:var(--card);border:1px solid var(--line);border-radius:2px;
    padding:22px;margin-bottom:24px;position:relative;
  }
  .panel::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--accent);}
  .panel-header{
    display:flex;align-items:center;justify-content:space-between;cursor:pointer;
    user-select:none;
  }
  .panel-header h2{margin:0;}
  .panel-arrow{
    color:var(--accent);font-size:14px;transition:transform 0.2s;flex-shrink:0;margin-left:10px;
  }
  .panel-arrow.open{transform:rotate(180deg);}
  .panel-body{display:none;margin-top:16px;}
  .panel-body.open{display:block;}
  .panel h2{
    font-size:12px;text-transform:uppercase;letter-spacing:0.12em;
    color:var(--muted);margin:0 0 16px;font-weight:600;
  }
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .field{display:flex;flex-direction:column;gap:5px;}
  .field.full{grid-column:1/-1;}
  label{font-size:11px;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);font-weight:600;}
  input, select, textarea{
    font-family:inherit;font-size:14px;padding:9px 10px;
    border:1px solid var(--line);border-radius:2px;background:#0F3A63;color:var(--ink);
  }
  input:focus, select:focus, textarea:focus{outline:2px solid var(--accent);outline-offset:1px;}
  .visit-type-toggle{display:flex;gap:8px;}
  .visit-type-toggle button{
    flex:1;padding:9px;border:1px solid var(--line);background:#0F3A63;border-radius:2px;
    cursor:pointer;font-size:13px;font-weight:600;color:var(--muted);
  }
  .visit-type-toggle button.active{background:var(--accent);border-color:var(--accent);color:var(--navy-900);}
  .loc-row{display:flex;gap:8px;}
  .loc-row input{flex:1;}
  .live-loc-btn{
    width:100%;padding:12px;font-size:14px;border-radius:2px;
  }
  .live-loc-btn.captured{background:var(--accent);color:var(--navy-900);border-color:var(--accent);}
  .geo-btn{
    white-space:nowrap;padding:9px 12px;border:1px solid var(--gold);background:transparent;color:var(--gold);
    border-radius:2px;cursor:pointer;font-size:12px;font-weight:600;
  }
  .geo-btn:hover{background:var(--gold);color:var(--navy-900);}
  .geo-status{font-size:11px;color:var(--muted);margin-top:4px;}
  .submit-row{margin-top:18px;display:flex;justify-content:flex-end;}
  .submit-btn{
    background:var(--accent);color:var(--navy-900);border:none;padding:11px 22px;border-radius:2px;
    font-size:13px;font-weight:700;letter-spacing:0.02em;cursor:pointer;
  }
  .submit-btn:hover{background:var(--sky-100);}
  .filters{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap;align-items:center;}
  .filters select, .filters input{flex:1;min-width:140px;}
  .filters .count{font-size:11px;color:var(--muted);white-space:nowrap;}
  .log{display:flex;flex-direction:column;gap:10px;}
  .entry{
    background:var(--card);border:1px solid var(--line);border-radius:2px;padding:14px 16px;
    display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:start;
  }
  .entry .tag{
    font-size:10px;text-transform:uppercase;letter-spacing:0.08em;font-weight:700;
    padding:4px 8px;border-radius:2px;height:fit-content;
  }
  .entry .tag.doctor{background:var(--accent-dim);color:var(--accent);}
  .entry .tag.pharmacy{background:rgba(110,162,179,0.18);color:var(--teal-400);}
  .entry .body-txt{min-width:0;}
  .entry .name{font-weight:700;font-size:15px;margin-bottom:2px;}
  .entry .meta{font-size:12px;color:var(--muted);margin-bottom:6px;}
  .entry .loc{font-size:12px;color:var(--ink);}
  .entry .loc a{color:var(--accent);text-decoration:none;}
  .entry .notes{font-size:12px;color:var(--muted);margin-top:6px;font-style:italic;}
  .entry .side{text-align:right;font-size:11px;color:var(--muted);font-family:'Courier New',monospace;}
  .entry .del{
    background:none;border:none;color:var(--danger);cursor:pointer;font-size:11px;
    margin-top:6px;text-decoration:underline;padding:0;
  }
  .entry .edit-visit{
    background:none;border:none;color:var(--accent);cursor:pointer;font-size:11px;
    margin-top:6px;margin-left:10px;text-decoration:underline;padding:0;
  }
  .edit-form{grid-template-columns:1fr !important;}
  .edit-form .locked-loc{font-size:11px;color:var(--muted);margin:4px 0 2px;}
  .edit-form .submit-row{margin-top:14px;}
  .empty{
    text-align:center;padding:50px 20px;color:var(--muted);
    border:1px dashed var(--line);border-radius:2px;font-size:13px;
  }
  .loading{text-align:center;padding:30px;color:var(--muted);font-size:13px;}
  .toast{
    position:fixed;bottom:20px;left:50%;transform:translateX(-50%);
    background:var(--accent);color:var(--navy-900);padding:10px 18px;border-radius:3px;
    font-size:13px;font-weight:600;opacity:0;pointer-events:none;transition:opacity 0.25s;z-index:50;
  }
  .toast.show{opacity:1;}

  /* Login screen */
  .login-screen{
    max-width:480px;margin:0 auto;padding-top:0;
  }
  .login-screen.wide{max-width:760px;}
  .hero-wrap{
    position:relative;
    padding:56px 20px 40px;
    margin-bottom:0;
    overflow:hidden;
    text-align:center;
  }
  .hero-wrap::before{
    content:"";
    position:absolute;inset:0;
    background-image:
      radial-gradient(circle at 15% 20%, rgba(123,189,232,0.16) 0%, transparent 40%),
      radial-gradient(circle at 85% 15%, rgba(78,142,162,0.18) 0%, transparent 45%),
      radial-gradient(circle at 50% 90%, rgba(110,162,179,0.12) 0%, transparent 50%);
    pointer-events:none;
  }
  .hero-wrap::after{
    content:"";
    position:absolute;inset:0;
    background-image:
      linear-gradient(rgba(123,189,232,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(123,189,232,0.06) 1px, transparent 1px);
    background-size:36px 36px;
    mask-image:radial-gradient(ellipse at center, black 0%, transparent 75%);
    pointer-events:none;
  }
  .hero-content{position:relative;z-index:1;}
  .hero-nav{
    display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:36px;
  }
  .hero-nav .falcon-badge{width:36px;height:36px;}
  .hero-nav .brand-word{
    font-family:'Space Grotesk',Arial,sans-serif;font-weight:700;font-size:15px;
    letter-spacing:0.06em;color:var(--sky-100);text-transform:uppercase;
  }
  .hero-title{
    font-family:'Space Grotesk',Arial,sans-serif;font-weight:700;
    font-size:34px;line-height:1.15;letter-spacing:0.01em;
    color:var(--sky-100);margin:0 0 14px;
  }
  .hero-title .accent{
    background:linear-gradient(90deg,var(--sky-300),var(--teal-400));
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  }
  .hero-subtext{
    font-size:14px;color:var(--muted);max-width:380px;margin:0 auto 30px;line-height:1.6;
  }
  .login-badge{display:flex;flex-direction:column;align-items:center;gap:10px;margin-bottom:28px;}
  .login-badge .falcon-badge{width:72px;height:72px;}
  .login-badge h1{font-size:32px;text-align:center;letter-spacing:0.03em;text-transform:none;background:linear-gradient(90deg,var(--sky-100),var(--sky-300));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
  .site-credit{
    text-align:center;font-size:11px;font-weight:300;letter-spacing:0.04em;
    color:var(--muted);margin-top:32px;opacity:0.7;
  }
  .role-tabs{display:flex;gap:8px;margin-bottom:20px;padding:0 20px;}
  .role-tabs button{
    flex:1;padding:13px 10px;border:1px solid var(--line);background:var(--card);border-radius:999px;
    cursor:pointer;font-size:12px;font-weight:700;letter-spacing:0.02em;color:var(--muted);
    transition:all 0.15s;
  }
  .role-tabs button.active{
    background:var(--accent);border-color:var(--accent);color:var(--navy-900);
    box-shadow:0 4px 16px rgba(123,189,232,0.35);
  }
  .login-panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:24px;margin:0 20px;}
  .login-panel .field{margin-bottom:14px;}
  .login-panel .hint{font-size:11px;color:var(--muted);margin-top:8px;line-height:1.5;}
  .feature-cards{
    display:grid;grid-template-columns:repeat(4,1fr);gap:12px;
    padding:40px 20px 8px;position:relative;z-index:1;
  }
  .feature-card{
    background:var(--card);border:1px solid var(--line);border-radius:12px;
    padding:16px 12px;text-align:left;
  }
  .feature-card .fc-icon{
    width:34px;height:34px;border-radius:9px;background:var(--accent-dim);
    display:flex;align-items:center;justify-content:center;font-size:16px;margin-bottom:10px;
  }
  .feature-card .fc-title{font-size:12px;font-weight:700;color:var(--sky-100);margin-bottom:4px;}
  .feature-card .fc-desc{font-size:10.5px;color:var(--muted);line-height:1.4;}
  @media (max-width:640px){
    .feature-cards{grid-template-columns:repeat(2,1fr);}
    .hero-title{font-size:26px;}
  }
  .login-error{font-size:12px;color:var(--danger);margin-top:8px;display:none;}
  .hidden{display:none !important;}

  /* Dashboard */
  .dash-summary{display:flex;gap:12px;margin-bottom:18px;flex-wrap:wrap;}
  .dash-summary .card{
    flex:1;min-width:120px;background:#0F3A63;border:1px solid var(--line);border-radius:2px;
    padding:12px 14px;
  }
  .dash-summary .card .num{font-size:22px;font-weight:700;font-family:'Courier New',monospace;color:var(--accent);}
  .dash-summary .card .label{font-size:10px;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);margin-top:2px;}
  .dash-row{
    display:grid;grid-template-columns:140px 1fr 60px 50px 50px;
    align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--line);
    font-size:13px;
  }
  .dash-row:last-child{border-bottom:none;}
  .dash-row.head{
    font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);
    font-weight:700;border-bottom:2px solid var(--ink);
  }
  .dash-name{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .bar-track{background:var(--accent-dim);border-radius:2px;height:10px;overflow:hidden;}
  .bar-fill{background:var(--accent);height:100%;}
  .dash-num{text-align:right;font-family:'Courier New',monospace;}
  .dash-toggle-btn{
    background:none;border:1px solid var(--line);border-radius:2px;padding:5px 10px;
    font-size:11px;cursor:pointer;color:var(--muted);margin-bottom:14px;
  }
  .dash-toggle-btn:hover{border-color:var(--accent);color:var(--accent);}

  /* All Members clickable list */
  .member-row{
    display:grid;grid-template-columns:1fr auto;align-items:center;gap:10px;
    padding:10px 12px;border-bottom:1px solid var(--line);cursor:pointer;
    border-radius:2px;transition:background 0.15s;
  }
  .member-row:last-child{border-bottom:none;}
  .member-row:hover{background:var(--accent-dim);}
  .member-row .mname{font-weight:600;font-size:14px;color:var(--ink);}
  .member-row .mcount{
    font-family:'Courier New',monospace;font-size:13px;color:var(--accent);
    background:var(--accent-dim);padding:3px 10px;border-radius:10px;
  }

  .custom-field-row{
    display:grid;grid-template-columns:1fr auto;align-items:center;gap:10px;
    padding:9px 12px;border-bottom:1px solid var(--line);
  }
  .custom-field-row:last-child{border-bottom:none;}
  .custom-field-row .cf-label{font-size:13px;color:var(--ink);}
  .custom-field-row .cf-del{
    background:none;border:none;color:var(--danger);cursor:pointer;font-size:11px;
    text-decoration:underline;padding:0;
  }
  .entry{cursor:pointer;}
  .entry:hover{background:var(--accent-dim);}

  /* Member detail modal */
  .modal-overlay{
    position:fixed;inset:0;background:rgba(0,10,20,0.65);
    display:flex;align-items:center;justify-content:center;z-index:100;padding:20px;
  }
  .modal-overlay.hidden{display:none;}
  .modal-box{
    background:var(--card);border:1px solid var(--line);border-radius:4px;
    max-width:560px;width:100%;max-height:80vh;display:flex;flex-direction:column;
    box-shadow:0 10px 40px rgba(0,0,0,0.4);
  }
  .modal-header{
    display:flex;align-items:center;justify-content:space-between;
    padding:16px 18px;border-bottom:1px solid var(--line);
  }
  .modal-close{
    background:none;border:none;color:var(--muted);font-size:16px;cursor:pointer;
    padding:4px 8px;
  }
  .modal-close:hover{color:var(--danger);}
  .modal-body{overflow-y:auto;padding:16px 18px;display:flex;flex-direction:column;gap:10px;}
  .modal-visit{
    border:1px solid var(--line);border-radius:2px;padding:10px 12px;font-size:13px;
  }
  .modal-visit .mv-top{display:flex;justify-content:space-between;gap:8px;margin-bottom:4px;}
  .modal-visit .mv-contact{font-weight:700;}
  .modal-visit .mv-date{color:var(--muted);font-family:'Courier New',monospace;font-size:12px;}
  .modal-visit .mv-meta{color:var(--muted);font-size:12px;margin-bottom:4px;}
  .modal-visit .mv-notes{color:var(--muted);font-size:12px;font-style:italic;}

  /* Falcons History gallery */
  .history-gallery{
    display:grid;grid-template-columns:repeat(auto-fill, minmax(140px,1fr));gap:10px;margin-top:14px;
  }
  .history-item{
    position:relative;border:1px solid var(--line);border-radius:2px;overflow:hidden;background:#0F3A63;
  }
  .history-item img{width:100%;height:120px;object-fit:cover;display:block;}
  .history-item .cap{
    font-size:11px;padding:6px 8px;color:var(--muted);line-height:1.3;
  }
  .history-item .del-photo{
    position:absolute;top:6px;right:6px;background:rgba(16,21,27,0.75);color:#fff;border:none;
    border-radius:2px;font-size:10px;padding:3px 6px;cursor:pointer;
  }
  .history-empty{
    grid-column:1/-1;text-align:center;padding:30px;color:var(--muted);font-size:12px;
    border:1px dashed var(--line);border-radius:2px;
  }
  .history-subhead{
    font-size:12px;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);
    font-weight:700;margin:18px 0 4px;border-bottom:1px solid var(--line);padding-bottom:6px;
  }
  .history-subhead:first-of-type{margin-top:0;}
  .question-block{
    border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin-bottom:16px;
  }
  .question-block .q-title{font-size:14px;font-weight:700;color:var(--sky-100);margin-bottom:10px;}
  .team-subhead{
    font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);
    font-weight:700;margin:10px 0 4px;
  }
  .team-subhead:first-of-type{margin-top:0;}
  .free-answer{
    font-size:12px;color:var(--ink);padding:4px 0;border-bottom:1px solid var(--line);
  }
  .free-answer:last-child{border-bottom:none;}
  .upload-row{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-bottom:6px;}
  .upload-row .field{flex:1;min-width:160px;}

  @media (max-width:560px){
    .grid{grid-template-columns:1fr;}
    .entry{grid-template-columns:1fr;}
    .entry .side{text-align:left;}
    header{align-items:flex-start;}
  }
</style>
</head>
<body>


<!-- LOGIN SCREEN -->
<div class="wrap login-screen" id="loginScreen">
  <div class="login-badge">
    <div class="falcon-badge">
      <img src="data:image/png;base64," alt="Falcons Workshop logo">
    </div>
    <h1>Falcons Workshop</h1>
    <p class="eyebrow" style="margin:0;">Sign in to continue</p>
  </div>

  <div class="role-tabs">
    <button type="button" id="tabMember" class="active">Member</button>
    <button type="button" id="tabModerator">Moderator</button>
    <button type="button" id="tabLeaders">Leaders</button>
    <button type="button" id="tabHistory">Falcons History</button>
    <button type="button" id="tabDashboard">Dashboard</button>
  </div>

  <div class="login-panel" id="memberLoginPanel">
    <div class="field">
      <label>Your Name</label>
      <input type="text" id="loginMemberName" placeholder="e.g. Ahmed Mostafa">
    </div>
    <div class="field">
      <label>Password</label>
      <input type="password" id="loginMemberPassword" placeholder="Enter your password">
    </div>
    <div class="field">
      <label>Your Team</label>
      <select id="loginMemberTeam"></select>
    </div>
    <div class="submit-row">
      <button class="submit-btn" id="memberLoginBtn" style="width:100%;">Continue as Member</button>
    </div>
    <div class="login-error" id="memberLoginError">Incorrect name or password. Ask a moderator for access.</div>
    <p class="hint">You'll be able to log your own visits and see your own history.</p>
  </div>

  <div class="login-panel hidden" id="moderatorLoginPanel">
    <div class="field">
      <label>Moderator Password</label>
      <input type="password" id="loginModPassword" placeholder="Enter password">
    </div>
    <div class="submit-row">
