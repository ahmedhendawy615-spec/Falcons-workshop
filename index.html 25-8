    teamVisits.forEach(v => {
      counts[v.member] = (counts[v.member] || 0) + 1;
    });
    const members = Object.entries(counts).sort((a,b) => b[1]-a[1]);
    const memberRows = members.length === 0
      ? '<div class="history-empty">No members yet.</div>'
