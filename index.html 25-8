/* Firebase visit-log paths are keyed by the exact team name, so
   Firebase Rules can compare `$teamKey` directly against
   falcons-members-real/{uid}/team or falcons-leaders-real/{uid}/team
   without needing to run any transform inside the Rules. Team names
   are validated (see saveTeamNamesBtn) to exclude characters that
   are illegal in Firebase keys, so no encoding is applied here. */
function encodeTeamKey(team){
  return (team || 'Unassigned').trim();
}

async function loadVisits(){
  if(session && session.role === 'moderator'){
    // Moderators can read the whole falcons-visit-log tree (grouped by
    // team) at once — flatten every team's visits into one list.
    const result = await dbGet('falcons-visit-log');
    const allTeams = result && typeof result === 'object' ? Object.values(result) : [];
    visits = allTeams
      .flatMap(teamNode => teamNode && typeof teamNode === 'object' ? Object.values(teamNode) : [])
      .sort((a,b) => (b.loggedAt || '').localeCompare(a.loggedAt || ''));
  }else{
    // Regular members can only read their own team's node per the
    // Rules — request that node directly rather than the whole tree.
    const teamKey = encodeTeamKey(session && session.team);
    const result = await dbGet(`falcons-visit-log/${teamKey}`);
    visits = result && typeof result === 'object'
      ? Object.values(result).sort((a,b) => (b.loggedAt || '').localeCompare(a.loggedAt || ''))
      : [];

    // Visits queued while offline (this device, not yet synced) won't
    // be in the server result above — merge them back in so they stay
    // visible across reloads, not just for the rest of this session.
    const pending = getPendingVisits().filter(v => v.member === session.name);
    pending.forEach(v => { v._pending = true; });
    visits = [...pending, ...visits.filter(v => !pending.some(p => p.id === v.id))];
  }
  renderAll();
}

async function saveOneVisit(visit){
  const teamKey = encodeTeamKey(visit.team);
  const ok = await dbSet(`falcons-visit-log/${teamKey}/${visit.id}`, visit);
  if(!ok) showToast('Save failed — check connection.');
  return ok;
}

async function deleteOneVisit(team, id){
  const teamKey = encodeTeamKey(team);
  const ok = await dbDelete(`falcons-visit-log/${teamKey}/${id}`);
  if(!ok) showToast('Delete failed — check connection.');
  return ok;
}

$('clearAllVisitsBtn').onclick = async () => {
  if(!session || session.role !== 'moderator') return;
  if(!confirm('This will permanently delete ALL visit logs for every team. This cannot be undone. Continue?')) return;
  const typed = prompt('Type DELETE (in capitals) to confirm.');
  if(typed !== 'DELETE'){ showToast('Cancelled — no logs were deleted.'); return; }

  // Deleted at the falcons-visit-log root in one call — moderators have
  // write access there per the Rules, and this also sweeps up any
  // stray buckets (like visits saved before a team was assigned, or
  // under a since-renamed team) that a per-team-name loop would miss.
  let allOk = await dbDelete('falcons-visit-log');

  // The public leaderboard reads from falcons-visit-summary, a separate
  // per-member aggregate that bumpVisitSummary keeps in sync on every
  // save/delete — but a bulk clear bypasses that, so it has to be reset
  // here too, one $slug at a time (moderators only have write access
  // at the $slug level per the Rules, not at the summary root).
  const summary = await dbGet('falcons-visit-summary');
  if(summary && typeof summary === 'object'){
    for(const slug of Object.keys(summary)){
      const ok = await dbDelete(`falcons-visit-summary/${slug}`);
      if(!ok) allOk = false;
    }
  }

  if(allOk){
    visits = [];
    showToast('All visit logs have been cleared.');
    renderAll();
  }else{
    showToast('Some logs failed to delete — check connection and try again.');
    await loadVisits();
  }
};

$('saveBtn').onclick = async () => {
  const contact = $('contactName').value.trim();
  const date = $('visitDate').value;
  const specialty = $('specialty').value.trim();
  const notes = $('notes').value.trim();

  if(!contact){
    showToast('Please fill in the name.');
    return;
  }
  if(!session.team){
    showToast('Your account has no team assigned — ask a moderator to fix this before logging visits.');
    return;
  }
  if(!geoCoords){
    showToast('Please tap "Log My Current Location" first.');
    return;
  }

  const customAnswers = {};
  document.querySelectorAll('.custom-answer-input').forEach(inp => {
    const val = inp.value.trim();
    if(val){
      customAnswers[inp.dataset.fieldId] = { label: inp.dataset.fieldLabel, value: val };
    }
  });

  const visit = {
    id: Date.now().toString(36) + Math.random().toString(36).slice(2,6),
    type: currentType,
    member: session.name,
    team: session.team || '',
    contact, date, specialty, notes,
    order: currentOrder,
    healthDay: currentHealthDay,
    customAnswers,
    coords: geoCoords,
    loggedAt: new Date().toISOString()
  };

  const saved = navigator.onLine ? await saveOneVisit(visit) : false;
  if(saved){
    bumpVisitSummary(visit.member, 1);
  }else{
    // Either genuinely offline, or the request just failed while we
    // thought we were online — queue it either way so nothing is lost.
    // saveOneVisit's PUT is keyed by the visit's own id, so replaying
    // it later on sync is always safe, never creates a duplicate.
    queueVisitOffline(visit);
    visit._pending = true;
    showToast(navigator.onLine
      ? 'Could not reach the server — visit saved on this device and will sync automatically.'
      : 'No connection — visit saved on this device, will sync automatically once you\'re back online.');
  }
  visits.unshift(visit);

  $('contactName').value = '';
  $('specialty').value = '';
  $('notes').value = '';
  document.querySelectorAll('.custom-answer-input').forEach(inp => inp.value = '');
  geoCoords = null;
  $('geoStatus').textContent = '';
  $('geoBtn').textContent = '📍 Log My Current Location';
  $('geoBtn').classList.remove('captured');
  setOrder('no');
  setHealthDay('no');

  if(saved) showToast('Visit saved.');
  updatePendingBadge();
  renderAll();
};

