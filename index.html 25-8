let dashSortDesc = true;
$('dashSortBtn').onclick = () => {
  dashSortDesc = !dashSortDesc;
  $('dashSortBtn').textContent = dashSortDesc ? 'Sort: Most visits first' : 'Sort: Fewest visits first';
  renderDashboard();
};

function renderDashboard(){
  if(session.role !== 'moderator') return;

  const totalVisits = visits.length;
  const totalMembers = new Set(visits.map(v => v.member)).size;
  const doctorCount = visits.filter(v => v.type === 'doctor').length;
  const pharmacyCount = visits.filter(v => v.type === 'pharmacy').length;

  $('dashSummary').innerHTML = `
    <div class="card"><div class="num">${totalVisits}</div><div class="label">Total Visits</div></div>
    <div class="card"><div class="num">${totalMembers}</div><div class="label">Active Members</div></div>
    <div class="card"><div class="num">${doctorCount}</div><div class="label">Doctor Visits</div></div>
    <div class="card"><div class="num">${pharmacyCount}</div><div class="label">Pharmacy Visits</div></div>
  `;

  const counts = {};
  visits.forEach(v => {
    if(!counts[v.member]) counts[v.member] = {doctor:0, pharmacy:0, total:0};
    counts[v.member][v.type] = (counts[v.member][v.type] || 0) + 1;
    counts[v.member].total += 1;
  });

  let rows = Object.entries(counts).map(([name, c]) => ({name, ...c}));
  rows.sort((a,b) => dashSortDesc ? b.total - a.total : a.total - b.total);

  const maxTotal = Math.max(1, ...rows.map(r => r.total));

  if(rows.length === 0){
    $('dashTable').innerHTML = '<div class="empty">No visits logged yet.</div>';
    return;
  }

  const head = `
    <div class="dash-row head">
      <div>Member</div><div>Visits</div><div>Total</div><div>Doc</div><div>Pharm</div>
    </div>`;

  const body = rows.map(r => `
    <div class="dash-row">
      <div class="dash-name">${escapeHtml(r.name)}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${(r.total/maxTotal*100).toFixed(0)}%"></div></div>
      <div class="dash-num">${r.total}</div>
      <div class="dash-num">${r.doctor || 0}</div>
      <div class="dash-num">${r.pharmacy || 0}</div>
    </div>
  `).join('');

  $('dashTable').innerHTML = head + body;
}

