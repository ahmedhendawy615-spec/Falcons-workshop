function renderLeaderStats(){
  const teamVisits = visits;

  const total = teamVisits.length;
  const orders = teamVisits.filter(v => v.order === 'yes').length;
  const healthDays = teamVisits.filter(v => v.healthDay === 'yes').length;
  const doctorCount = teamVisits.filter(v => v.type === 'doctor').length;
  const pharmacyCount = teamVisits.filter(v => v.type === 'pharmacy').length;

  $('leaderSummary').innerHTML = `
    <div class="card"><div class="num">${total}</div><div class="label">Total Visits</div></div>
    <div class="card"><div class="num">${orders}</div><div class="label">Orders</div></div>
    <div class="card"><div class="num">${healthDays}</div><div class="label">Health Days</div></div>
    <div class="card"><div class="num">${doctorCount}</div><div class="label">Doctor Visits</div></div>
    <div class="card"><div class="num">${pharmacyCount}</div><div class="label">Pharmacy Visits</div></div>
  `;

  const counts = {};
  teamVisits.forEach(v => {
    counts[v.member] = (counts[v.member] || 0) + 1;
  });
  const rows = Object.entries(counts).sort((a,b) => b[1] - a[1]);
  const maxCount = Math.max(1, ...rows.map(r => r[1]));

  const memberList = $('leaderMemberList');
  if(rows.length === 0){
    memberList.innerHTML = '<div class="history-empty">No visits logged for this team yet.</div>';
  }else{
    memberList.innerHTML = rows.map(([name, count]) => `
      <div class="dash-row">
        <div class="dash-name">${escapeHtml(name)}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${(count/maxCount*100).toFixed(0)}%"></div></div>
        <div class="dash-num">${count}</div>
        <div></div><div></div>
      </div>
    `).join('');
  }

  renderLeaderCustomInsights(teamVisits);
  renderLeaderVisitTimeline();
}

