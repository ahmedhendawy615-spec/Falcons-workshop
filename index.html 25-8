async function renderCustomFieldsSettings(){
  const fields = await getCustomFields();
  const container = $('customFieldsList');
  if(fields.length === 0){
    container.innerHTML = '<div class="history-empty">No custom questions yet.</div>';
    return;
  }
  container.innerHTML = fields.map(f => `
    <div class="custom-field-row" data-id="${f.id}" style="flex-direction:column;align-items:stretch;display:flex;gap:8px;">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
        <div class="cf-label">${escapeHtml(f.label)}${f.type === 'choice' ? ` <span style="color:var(--muted);font-size:11px;">(${f.options.map(escapeHtml).join(', ')})</span>` : ' <span style="color:var(--muted);font-size:11px;">(free text)</span>'}</div>
        <div style="display:flex;gap:10px;flex-shrink:0;">
          <button class="cf-edit" data-id="${f.id}" style="background:none;border:none;color:var(--accent);cursor:pointer;font-size:11px;text-decoration:underline;padding:0;">Edit</button>
          <button class="cf-del" data-id="${f.id}">Remove</button>
        </div>
      </div>
      <div class="cf-edit-form hidden" data-id="${f.id}" style="display:none;gap:8px;flex-wrap:wrap;">
        <input type="text" class="cf-edit-label" value="${escapeHtml(f.label)}" style="flex:1;min-width:140px;padding:8px;border:1px solid var(--line);border-radius:2px;background:var(--card);color:var(--ink);">
        <input type="text" class="cf-edit-options" placeholder="Options, comma-separated (blank = free text)" value="${f.type === 'choice' ? escapeHtml(f.options.join(', ')) : ''}" style="flex:1;min-width:200px;padding:8px;border:1px solid var(--line);border-radius:2px;background:var(--card);color:var(--ink);">
        <button class="submit-btn cf-save" data-id="${f.id}">Save</button>
      </div>
    </div>
  `).join('');

  container.querySelectorAll('.cf-edit').forEach(btn => {
    btn.onclick = () => {
      const form = container.querySelector(`.cf-edit-form[data-id="${btn.dataset.id}"]`);
      form.style.display = form.style.display === 'none' ? 'flex' : 'none';
    };
  });

  container.querySelectorAll('.cf-save').forEach(btn => {
    btn.onclick = async () => {
      const form = container.querySelector(`.cf-edit-form[data-id="${btn.dataset.id}"]`);
      const newLabel = form.querySelector('.cf-edit-label').value.trim();
      const newOptionsRaw = form.querySelector('.cf-edit-options').value.trim();
      if(!newLabel){ showToast('Label cannot be empty.'); return; }

      const fields = await getCustomFields();
      const idx = fields.findIndex(f => f.id === btn.dataset.id);
      if(idx === -1) return;
      fields[idx].label = newLabel;
      if(newOptionsRaw){
        fields[idx].type = 'choice';
        fields[idx].options = newOptionsRaw.split(',').map(s => s.trim()).filter(Boolean);
      }else{
        fields[idx].type = 'text';
        delete fields[idx].options;
      }
      const ok = await dbSet('falcons-custom-fields', fields);
      if(ok){
        showToast('Question updated.');
        renderCustomFieldsSettings();
        renderCustomFieldsForm();
      }else{
        showToast('Could not update question.');
      }
    };
  });

  container.querySelectorAll('.cf-del').forEach(btn => {
    btn.onclick = async () => {
      if(!confirm('Remove this question? Past answers to it will stay on old visits, but the question will no longer appear.')) return;
      const fields = await getCustomFields();
      const updated = fields.filter(f => f.id !== btn.dataset.id);
      const ok = await dbSet('falcons-custom-fields', updated);
      if(ok){
        showToast('Question removed.');
        renderCustomFieldsSettings();
        renderCustomFieldsForm();
      }
    };
  });
}

$('addCustomFieldBtn').onclick = async () => {
