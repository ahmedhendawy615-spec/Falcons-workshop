function escapeHtml(s){
  return (s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function mapLink(v){
  if(v.coords) return `https://www.google.com/maps?q=${v.coords.lat},${v.coords.lng}`;
  return '#';
}

function locLabel(v){
  if(v.coords) return `${v.coords.lat.toFixed(5)}, ${v.coords.lng.toFixed(5)}`;
  return 'No location logged';
}

function renderList(){
  const isMod = session.role === 'moderator';
  const memberF = isMod ? $('filterMember').value : session.name;
  const typeF = $('filterType').value;
  const q = $('searchBox').value.trim().toLowerCase();

  let filtered = visits.filter(v => {
    if(memberF && v.member !== memberF) return false;
    if(typeF && v.type !== typeF) return false;
    if(q && !v.contact.toLowerCase().includes(q)) return false;
    return true;
  });

  $('resultCount').textContent = `${filtered.length} shown`;
  $('totalCount').textContent = isMod ? visits.length : visits.filter(v=>v.member===session.name).length;

  const list = $('logList');
  if(filtered.length === 0){
    list.innerHTML = '<div class="empty">No visits logged yet. Add the first one above.</div>';
    return;
  }

  list.innerHTML = filtered.map(v => `
    <div class="entry" data-id="${v.id}">
      <span class="tag ${v.type}">${v.type}</span>
      <div class="body-txt">
        <div class="name">${escapeHtml(v.contact)}</div>
        <div class="meta">Visited by ${escapeHtml(v.member)}${v.specialty ? ' · ' + escapeHtml(v.specialty) : ''}${v.order === 'yes' ? ' · <span style="color:var(--accent);font-weight:600;">Order: Yes</span>' : ''}${v.healthDay === 'yes' ? ' · <span style="color:var(--gold);font-weight:600;">Health Day</span>' : ''}${v._pending ? ' · <span style="color:#e0b23a;font-weight:600;">⏳ Pending sync</span>' : ''}</div>
        <div class="loc">📍 ${v.coords ? `<a href="${mapLink(v)}" target="_blank" rel="noopener">${locLabel(v)}</a>` : locLabel(v)}</div>
        ${v.notes ? `<div class="notes">"${escapeHtml(v.notes)}"</div>` : ''}
      </div>
      <div class="side">
        ${v.date || ''}
        ${(isMod || v.member===session.name) ? `<div><button class="del" data-id="${v.id}">Delete</button>${v.member===session.name ? `<button class="edit-visit" data-id="${v.id}">Edit</button>` : ''}</div>` : ''}
      </div>
    </div>
  `).join('');

  list.querySelectorAll('.del').forEach(btn => {
    btn.onclick = async (e) => {
      e.stopPropagation();
      if(!confirm('Delete this visit? This cannot be undone.')) return;
      const deleted = visits.find(v => v.id === btn.dataset.id);
      if(!deleted) return;

      if(deleted._pending){
        // Never made it to the server yet — just drop it from the
        // local queue, no network call needed (and none would find
        // anything to delete anyway).
        savePendingVisits(getPendingVisits().filter(v => v.id !== deleted.id));
        updatePendingBadge();
        visits = visits.filter(v => v.id !== btn.dataset.id);
        renderAll();
        return;
      }

      const ok = await deleteOneVisit(deleted.team, deleted.id);
      if(ok){
        visits = visits.filter(v => v.id !== btn.dataset.id);
        bumpVisitSummary(deleted.member, -1);
        renderAll();
      }
    };
  });

  list.querySelectorAll('.edit-visit').forEach(btn => {
    btn.onclick = async (e) => {
      e.stopPropagation();
      const entryEl = btn.closest('.entry');
      const existingForm = list.querySelector(`.edit-form[data-edit-id="${btn.dataset.id}"]`);
      if(existingForm){ existingForm.remove(); return; }
      const v = visits.find(x => x.id === btn.dataset.id);
      if(!v) return;
      const fields = await getCustomFields();
      entryEl.insertAdjacentHTML('afterend', renderEditForm(v, fields));
      const formEl = list.querySelector(`.edit-form[data-edit-id="${v.id}"]`);
      formEl.querySelector('.edit-cancel').onclick = (ev) => { ev.stopPropagation(); formEl.remove(); };
      formEl.querySelector('.edit-save').onclick = async (ev) => {
        ev.stopPropagation();
        const contact = formEl.querySelector('.edit-contact').value.trim();
        if(!contact){ showToast('Please fill in the name.'); return; }
        const updated = collectEditForm(formEl, v);
        const ok = await saveOneVisit(updated);
        if(ok){
          visits = visits.map(x => x.id === updated.id ? updated : x);
          showToast('Visit updated.');
          renderAll();
        }else{
          showToast('Update failed — check connection.');
        }
      };
    };
  });

  list.querySelectorAll('.entry:not(.edit-form)').forEach(el => {
    el.onclick = () => openVisitDetail(el.dataset.id);
  });
}

function renderEditForm(v, fields){
  const customHtml = fields.map(f => {
    const existing = (v.customAnswers && v.customAnswers[f.id]) ? v.customAnswers[f.id].value : '';
    if(f.type === 'choice'){
      return `
        <div class="field">
          <label>${escapeHtml(f.label)}</label>
          <select class="edit-custom-input" data-field-id="${f.id}" data-field-label="${escapeHtml(f.label)}">
            <option value="">—</option>
            ${f.options.map(o => `<option value="${escapeHtml(o)}" ${o===existing?'selected':''}>${escapeHtml(o)}</option>`).join('')}
          </select>
        </div>`;
    }else{
      return `
        <div class="field">
          <label>${escapeHtml(f.label)}</label>
          <input type="text" class="edit-custom-input" data-field-id="${f.id}" data-field-label="${escapeHtml(f.label)}" value="${escapeHtml(existing)}">
        </div>`;
    }
  }).join('');

  return `
    <div class="entry edit-form" data-edit-id="${v.id}">
      <div class="grid">
        <div class="field">
          <label>Visit Type</label>
          <select class="edit-type">
            <option value="doctor" ${v.type==='doctor'?'selected':''}>Doctor</option>
            <option value="pharmacy" ${v.type==='pharmacy'?'selected':''}>Pharmacy</option>
          </select>
        </div>
        <div class="field">
          <label>Contact Name</label>
          <input type="text" class="edit-contact" value="${escapeHtml(v.contact)}">
        </div>
        <div class="field">
          <label>Date</label>
          <input type="date" class="edit-date" value="${v.date || ''}">
        </div>
        <div class="field">
          <label>Specialty</label>
          <input type="text" class="edit-specialty" value="${escapeHtml(v.specialty || '')}">
        </div>
        <div class="field">
          <label>Order Placed?</label>
          <select class="edit-order">
            <option value="no" ${v.order!=='yes'?'selected':''}>No</option>
            <option value="yes" ${v.order==='yes'?'selected':''}>Yes</option>
          </select>
        </div>
        <div class="field">
          <label>Health Day?</label>
          <select class="edit-healthday">
            <option value="no" ${v.healthDay!=='yes'?'selected':''}>No</option>
            <option value="yes" ${v.healthDay==='yes'?'selected':''}>Yes</option>
          </select>
        </div>
        ${customHtml}
        <div class="field full">
          <label>Notes</label>
          <textarea class="edit-notes" rows="2">${escapeHtml(v.notes || '')}</textarea>
        </div>
      </div>
      <div class="locked-loc">📍 Location locked at ${escapeHtml(locLabel(v))} — this can't be changed after the visit was first logged.</div>
      <div class="submit-row">
        <button type="button" class="logout-btn edit-cancel">Cancel</button>
        <button type="button" class="submit-btn edit-save" style="margin-left:8px;">Save Changes</button>
      </div>
    </div>
  `;
}

function collectEditForm(formEl, original){
  const customAnswers = {};
  formEl.querySelectorAll('.edit-custom-input').forEach(inp => {
    const val = inp.value.trim();
    if(val){
      customAnswers[inp.dataset.fieldId] = { label: inp.dataset.fieldLabel, value: val };
    }
  });
  return {
    ...original,
    type: formEl.querySelector('.edit-type').value,
    contact: formEl.querySelector('.edit-contact').value.trim(),
    date: formEl.querySelector('.edit-date').value,
    specialty: formEl.querySelector('.edit-specialty').value.trim(),
    order: formEl.querySelector('.edit-order').value,
    healthDay: formEl.querySelector('.edit-healthday').value,
    notes: formEl.querySelector('.edit-notes').value.trim(),
    customAnswers,
    coords: original.coords // locked — the edit form never reads or writes this
